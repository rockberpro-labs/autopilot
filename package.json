{
  "name": "autopilot",
  "version": "0.1.0",
  "description": "Run a multi-step plan with Claude Code, one fresh session per step",
  "type": "module",
  "bin": {
    "autopilot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
